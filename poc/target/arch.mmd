flowchart TB
    subgraph clients["Clients"]
        user["Tester / client<br/>client1001…client1005 (cus = 1001…1005)"]
        pf["promptfoo / curl (OpenAI-compatible)"]
    end

    subgraph llm["LLM provider"]
        provider["any OpenAI-compatible endpoint<br/>(local / in-perimeter)"]
    end

    subgraph stand["Docker Compose stand"]
        librechat["librechat :3080 — chat UI, own OIDC login"]
        oauth2proxy["oauth2-proxy :8501 — SSO + API keys + /memory"]
        agentapi["agent-api :8600 — FastAPI, OpenAI-compatible<br/>/v1/chat/completions, /finalize"]
        keycloak["keycloak :8180 http / :8443 https — IAM, realm genai-stand"]

        agent["ReAct agent (app/agent/runner.py)"]
        orchestrator["Memory orchestrator (app/orchestrator/graph.py)"]

        subgraph invest["Invest MCP — 2 BAC layers"]
            mcpinvest["mcp-invest :8100 — 14 read tools · LLM↔IAM boundary"]
            investserver["invest-server :8200 — REST · service↔service boundary"]
        end

        redis[("redis :6379 — working memory")]
        mongo[("mongo :27017 — long-term memory + LibreChat")]
        postgres[("postgres — client data")]
    end

    ddg["DuckDuckGo — web search"]

    user -- "OIDC login" --> librechat
    user -- "OIDC login" --> oauth2proxy
    librechat -- "Bearer sk-genai-…" --> agentapi
    pf -- "Bearer sk-genai-…" --> agentapi
    oauth2proxy -- "X-Forwarded-Access-Token" --> agentapi
    oauth2proxy -. "verify SSO session" .-> keycloak
    librechat -. "OIDC discovery/token" .-> keycloak

    agentapi --> agent
    agentapi --> orchestrator
    agentapi <--> redis
    agentapi <--> mongo
    orchestrator <--> mongo
    agent -- "MCP tools (streamable HTTP)" --> mcpinvest
    agent -. "Bearer token" .-> keycloak
    mcpinvest -. "token validation (JWKS)" .-> keycloak
    mcpinvest --> investserver
    investserver -. "token validation (JWKS)" .-> keycloak
    investserver --> postgres
    agent -. "web search" .-> ddg
    agent -- "chat completions" --> provider
