# Copy this file to .env and replace every value. Never commit the resulting .env.
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me
LANGFUSE_INIT_USER_EMAIL=admin@example.test
LANGFUSE_INIT_USER_NAME=Local Admin
LANGFUSE_INIT_USER_PASSWORD=replace-me

# Generate local secrets with: openssl rand -hex 32
LANGFUSE_SALT=replace-me
LANGFUSE_ENCRYPTION_KEY=replace-me-with-64-hex-characters
LANGFUSE_AUTH_SECRET=replace-me
POSTGRES_PASSWORD=replace-me
CLICKHOUSE_PASSWORD=replace-me
MINIO_ROOT_PASSWORD=replace-me
REDIS_AUTH=replace-me
