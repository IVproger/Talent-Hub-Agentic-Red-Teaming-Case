# OpenAI-compatible API provider.
# For OpenRouter use: https://openrouter.ai/api/v1
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Models use LangChain init_chat_model format: provider:model
RESEARCH_MODEL=openai:openai/gpt-5-mini
SUMMARIZATION_MODEL=openai:openai/gpt-5-mini

# Keep limits moderate for OpenRouter/free-credit accounts.
RESEARCH_MODEL_MAX_TOKENS=2048
SUMMARIZATION_MODEL_MAX_TOKENS=1024
MAX_REACT_TOOL_CALLS=2

# Optional distributed tracing. Use the same project keys as the runner.
# The container reaches the local Langfuse deployment through the Docker host.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://host.docker.internal:3001
LANGFUSE_TRACING_ENVIRONMENT=local

# Storage
REDIS_URL=redis://localhost:6379/0
MONGO_URI=mongodb://localhost:27017
MONGO_DB=agent_memory
WORKING_MEMORY_TTL=86400

# MCP-сервер Инвеста (эмуляция, синтетические данные). В docker-compose задаётся
# автоматически (http://mcp-invest:8000); значение ниже нужно только для запуска вне Docker.
MCP_INVEST_URL=http://localhost:8100

# Keycloak (IAM для MCP Инвеста и SSO, реалм genai-stand импортируется из keycloak/realm-export.json).
# В docker-compose задаётся автоматически (http://keycloak:8080); значения ниже — для запуска вне Docker.
KEYCLOAK_URL=http://localhost:8180
# Канонический (browser-facing, HTTPS) адрес Keycloak — используется для ссылок логаута
# и для валидации claim `iss` (см. KC_HOSTNAME в docker-compose.yml).
KEYCLOAK_ISSUER_URL=https://localhost:8443
KEYCLOAK_REALM=genai-stand
AGENT_CLIENT_ID=agent-service
AGENT_CLIENT_SECRET=agent-service-secret
UI_CLIENT_ID=streamlit-ui
UI_CLIENT_SECRET=streamlit-ui-secret
STREAMLIT_APP_CLIENT_ID=streamlit-app
