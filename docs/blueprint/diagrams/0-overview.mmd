flowchart TD
    subgraph IN["ВХОД — что даёт пользователь"]
        A1[/"Архитектура системы<br/>обязательно"/]
        A2[/"Системная карта<br/>обязательно"/]
        A3[/"Доп. документы<br/>OpenAPI · README · …"/]
        A4[/"Точка входа и доступы"/]
    end

    P1["MOROK: анализ артефактов<br/>и генерация профиля"]
